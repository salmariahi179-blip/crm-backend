generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  COMPANY
  PERSON
}

enum OpportunityStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Client {
  id        String   @id @default(cuid())
  type      ClientType
  name      String
  email     String?
  phone     String?

  // Utilisé uniquement pour les entreprises
  companyName String?
  address     String?

  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id                String           @id @default(cuid())
  title             String
  amount            Float
  stage             OpportunityStage
  expectedCloseDate DateTime

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}